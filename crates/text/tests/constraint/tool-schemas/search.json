{
  "title": "search",
  "description": "Search an index and return the top results.",
  "type": "object",
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 20 },
    "site": { "anyOf": [{ "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" }, { "type": "null" }] },
    "safe": { "type": "boolean" }
  },
  "required": ["query", "max_results"],
  "additionalProperties": false
}
