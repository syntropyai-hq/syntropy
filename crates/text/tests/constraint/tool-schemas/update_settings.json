{
  "title": "update_settings",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z]+(\\.[a-z]+)*$" },
          "value": { "anyOf": [{ "type": "string" }, { "type": "integer" }, { "type": "boolean" }, { "type": "null" }] }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      }
    },
    "reason": { "type": "string", "maxLength": 50 }
  },
  "required": ["changes"],
  "additionalProperties": false
}
