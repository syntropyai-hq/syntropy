#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Opt-in checks on each commit message. Enable them with `git config core.hooksPath .githooks`.
#
#   sign-off      a `Signed-off-by:` line that matches the commit's author (the DCO, CONTRIBUTING.md)
#   subject       a conventional-commit subject, `type(scope): subject`, with a type AGENTS.md
#                 allows
#   naming check  plan/implementation/tools/naming_check.py --message (AGENTS.md, "Naming (D5)"),
#                 when a banned-terms list is set: `git config syntropy.bannedTerms <path>`
#
# The authoritative checks are `cargo xtask ci dco` and `cargo xtask ci pr-title` (QUAL-E1-T05),
# which CI runs over a PR's data; pr-title also checks the scope list and the breaking-marker
# label. They need a build and a PR, so this hook keeps its own minimal sign-off and subject checks.
#
# POSIX sh, so it runs in Git for Windows' shell and on macOS. A check whose input is missing is
# skipped with one notice line, and the other checks still run.

set -u

message=$1
# common.sh comes from this hook's own directory, wherever core.hooksPath points. The naming check
# comes from the repository being committed to.
hooks=$(CDPATH="" cd -- "$(dirname -- "$0")" && pwd) || exit 2
root=$(git rev-parse --show-toplevel) || exit 2
# shellcheck source=common.sh
. "$hooks/common.sh"
naming=$root/plan/implementation/tools/naming_check.py

failed=""

note() {
    printf 'commit-msg: %s\n' "$*"
}

# Whether a subject is git's own for a merge commit: "Merge branch ...", "Merge remote-tracking
# branch ...", "Merge commit ...", "Merge tag ...", "Merge pull request ...".
is_merge_subject() {
    case $1 in
    'Merge '*) return 0 ;;
    *) return 1 ;;
    esac
}

# The message as git records it: carriage returns removed, since an editor on Windows may save
# the message with CRLF endings; the part below a `git commit -v` scissors line dropped; then
# comment lines and surplus blank lines stripped.
clean=$(tr -d '\015' <"$message" | sed '/^. -\{24\} >8 -\{24\}$/,$d' | git stripspace --strip-comments) || exit 2
if [ -z "$clean" ]; then
    exit 0 # git aborts an empty message itself
fi
subject=$(printf '%s\n' "$clean" | sed -n '1p')

case $subject in
'fixup! '* | 'squash! '* | 'amend! '*)
    note "subject: skipped for a commit that autosquash will fold into another"
    ;;
*)
    if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
        note "subject: skipped for a merge commit"
    elif is_merge_subject "$subject" && git rev-parse -q --verify 'HEAD^2' >/dev/null; then
        # `git commit --amend` on a merge commit leaves no MERGE_HEAD, but HEAD, the commit being
        # amended, has a second parent. Only squash-merge titles must be conventional (pr-title),
        # so a branch merge keeps git's "Merge ..." subject. A new commit made on top of a merge
        # with a "Merge ..." subject is skipped too: the hook cannot tell it from an amend.
        note "subject: skipped for an amended merge commit"
    elif ! printf '%s\n' "$subject" |
        grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([^()]+\))?!?: [^ ]'; then
        note "subject: FAIL: write 'type(scope): subject', with type one of feat, fix, perf, refactor, docs, test, build, ci, chore or revert"
        failed="$failed subject"
    else
        note "subject: ok"
    fi
    ;;
esac

# `git var GIT_AUTHOR_IDENT` is "Name <email> <seconds> <zone>"; the sign-off carries the first two.
author=$(git var GIT_AUTHOR_IDENT | sed 's/ [0-9][0-9]* [-+][0-9][0-9]*$//') || exit 2
if ! printf '%s\n' "$clean" | grep -Fqxi "Signed-off-by: $author"; then
    note "sign-off: FAIL: add 'Signed-off-by: $author' (git commit -s)"
    failed="$failed sign-off"
else
    note "sign-off: ok"
fi

if ! same_checkout "$hooks"; then
    note "naming check: skipped, this checkout is not the one these hooks are in"
elif [ ! -f "$naming" ]; then
    note "naming check: skipped, this repository has no plan/implementation/tools/naming_check.py"
elif python=$(find_python); then
    if ! "$python" "$naming" --message "$message"; then
        failed="$failed naming"
    fi
else
    note "naming check: skipped, no Python 3 found (python3 or python)"
fi

if [ -n "$failed" ]; then
    note "commit refused:$failed"
    exit 1
fi
exit 0
